# Модель эмбеддингов.
#   deepvk/USER-bge-m3     — дистилляция BAAI/bge-m3 для русского (359M, ~1.4 ГБ, dim 768).
#   BAAI/bge-m3            — оригинальная мультиязычная BGE (568M, ~2.3 ГБ).
#   BAAI/bge-small-en-v1.5 — самая лёгкая BGE, но только английский (33M, ~130 МБ).
EMBEDDING_MODEL=deepvk/USER-bge-m3

# Чанкинг
CHUNK_SIZE=1000        # максимальный размер чанка, символов
CHUNK_OVERLAP=200      # перекрытие соседних чанков, символов

# Сколько чанков эмбеддить за один батч
BATCH_SIZE=32

# --- Генерация ответов (GigaChat API) ---
# Authorization-ключ из личного кабинета GigaChat
GIGACHAT_CREDENTIALS=твой_authorization_key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Косинус ниже порога = чанк нерелевантен, LLM не вызывается
RELEVANCE_THRESHOLD=0.50
